# ---------------------------------------------------------------------------
# Reply engine configuration. Copy to .env and fill in. Never commit .env.
# Every value is optional: with none of them set, the engine runs fully
# offline using the template realizer and the in-memory store.
# ---------------------------------------------------------------------------

# --- Voice -----------------------------------------------------------------
# Which voice profile to speak with (file name in src/voice/profiles, no .json)
VOICE_PROFILE=standard-locator

# --- Realizer backend ------------------------------------------------------
# template = deterministic phrase bank (no network, always available)
# llm      = model-written text constrained by the voice profile, template fallback
REALIZER=template
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# --- Storage ---------------------------------------------------------------
# memory | file
STORE=memory
STORE_PATH=./data/conversations.json

# --- Instagram (Meta Graph API) --------------------------------------------
# Used only by the instagram channel adapter.
IG_VERIFY_TOKEN=
IG_APP_SECRET=
IG_PAGE_ACCESS_TOKEN=
IG_ACCOUNT_ID=
IG_GRAPH_VERSION=v21.0

# --- Operations ------------------------------------------------------------
PORT=3000
# Outside these hours (local, 24h) replies are queued, not sent.
QUIET_HOURS_START=21
QUIET_HOURS_END=8
# Hard stop: never send more than this many messages per thread per hour.
MAX_MESSAGES_PER_THREAD_PER_HOUR=12
# Set to 1 to compose replies but never actually deliver them.
DRY_RUN=0
